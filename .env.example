# Restrict the MCP to one or more project roots. Separate roots with ';' on
# Windows and ':' on macOS.
CUBEMX_MCP_ALLOWED_ROOTS=C:\path\to\stm32-projects

# Optional explicit launcher override.
CUBEMX_MCP_CUBEMX_PATH=C:\Program Files\STMicroelectronics\STM32Cube\STM32CubeMX\STM32CubeMX.exe

# Do not enable this option for normal use. It permits file application without
# a successful STM32CubeMX validation pass.
CUBEMX_MCP_ALLOW_UNVALIDATED_APPLY=false

# Limit project copies and file comparisons during regeneration previews.
CUBEMX_MCP_MAX_PROJECT_FILES=20000
CUBEMX_MCP_MAX_PROJECT_BYTES=524288000
